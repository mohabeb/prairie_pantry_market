<!DOCTYPE html>
<html>
  <head>
    <title>Prairie Pantry Market</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="brand-row">
        <h1>Prairie Pantry Market</h1>
        <p class="tagline">Local pantry products, gifts, and everyday favourites.</p>
      </div>

      <%= render "layouts/navigation" %>
    </header>

    <section class="breadcrumb-bar">
      <% breadcrumb_items.each_with_index do |item, index| %>
        <% label, path = item %>
        <% if index < breadcrumb_items.length - 1 %>
          <%= link_to label, path %>
          <span>/</span>
        <% else %>
          <strong><%= label %></strong>
        <% end %>
      <% end %>
    </section>

    <% if notice.present? %>
      <p class="notice"><%= notice %></p>
    <% end %>

    <% if alert.present? %>
      <p class="alert"><%= alert %></p>
    <% end %>

    <main class="page-container">
      <%= yield %>
    </main>
  </body>
</html>
