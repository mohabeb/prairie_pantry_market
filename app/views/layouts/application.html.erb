<!DOCTYPE html>
<html>
  <head>
    <title>Prairie Pantry Market</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <div class="branding-wrap">
          <div class="brand-main">
            <%= link_to root_path, class: "brand-logo-link" do %>
              <div class="brand-logo">PPM</div>
            <% end %>

            <div class="brand-text">
              <h1 class="site-title">
                <%= link_to "Prairie Pantry Market", root_path %>
              </h1>

              <p class="site-tagline">
                Local pantry products, gifts, and everyday favourites.
              </p>
            </div>
          </div>

          <nav class="main-nav">
            <%= link_to "Products", products_path, class: "nav-pill" %>
            <%= link_to "Cart", cart_path, class: "nav-pill" %>
            <%= link_to "Orders", orders_path, class: "nav-pill" %>
            <%= link_to "About", "/about", class: "nav-pill" %>
            <%= link_to "Contact", "/contact", class: "nav-pill" %>
            <%= link_to "Admin", "/admin", class: "nav-pill nav-pill-admin", title: "Admin Dashboard" %>
          </nav>
        </div>
      </div>
    </header>

    <main class="page-container">
      <% if notice.present? %>
        <div class="flash-message flash-notice">
          <%= notice %>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="flash-message flash-alert">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>