<section class="cart-page">
  <h1>Your Shopping Cart</h1>

  <% if @cart_items.empty? %>
    <div class="empty-state cart-card">
      <h2>Your cart is empty</h2>
      <p>Add products from the store and they will appear in the cart table below.</p>

      <table class="clean-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Line Total</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td colspan="4">No items added yet.</td>
          </tr>
        </tbody>
      </table>

      <p class="page-actions">
        <%= link_to "Continue Shopping", products_path, class: "btn-secondary" %>
      </p>
    </div>
  <% else %>
    <div class="cart-card">
      <table class="clean-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Unit Price</th>
            <th>Quantity</th>
            <th>Line Total</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% @cart_items.each do |item| %>
            <% product = item[:product] %>

            <tr>
              <td>
                <strong><%= link_to product.name, product_path(product) %></strong>
              </td>

              <td>
                <%= number_to_currency(product.price) %>
              </td>

              <td>
                <%= form_with url: update_cart_path(product), method: :patch, local: true, class: "inline-form" do %>
                  <%= number_field_tag :quantity, item[:quantity], min: 1, class: "quantity-input" %>
                  <%= submit_tag "Update", class: "btn-small" %>
                <% end %>
              </td>

              <td>
                <%= number_to_currency(item[:line_total_cents].to_i / 100.0) %>
              </td>

              <td>
                <%= button_to "Remove", remove_from_cart_path(product), method: :delete, class: "btn-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class="cart-total-box">
        <h2>Cart Total: <%= number_to_currency(@cart_total_cents.to_i / 100.0) %></h2>
      </div>

      <div class="page-actions">
        <%= link_to "Continue Shopping", products_path, class: "btn-secondary" %>
        <%= link_to "Checkout", checkout_path, class: "btn-primary" %>
      </div>
    </div>
  <% end %>
</section>