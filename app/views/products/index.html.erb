<section class="catalog-page">
  <div class="catalog-header">
    <h2>Shop Local Pantry Products</h2>
    <p>
      Browse local coffee, tea, honey, jam, snacks, and gift boxes from Prairie Pantry Market.
    </p>
  </div>

  <div class="catalog-layout">
    <aside class="catalog-sidebar">
      <div class="sidebar-card">
        <h3>Search Products</h3>

        <%= form_with url: products_path, method: :get, local: true, class: "search-form" do %>
          <div class="form-group">
            <label for="keyword">Keyword</label>
            <%= text_field_tag :keyword, params[:keyword], placeholder: "Search by name or description" %>
          </div>

          <div class="form-group">
            <label for="category_id">Category</label>
            <%= select_tag :category_id,
                options_for_select([["All categories", ""]] + @categories.map { |c| [c.name, c.id] }, params[:category_id]) %>
          </div>

          <div class="form-group">
            <%= submit_tag "Search", class: "btn-primary" %>
          </div>
        <% end %>
      </div>

      <div class="sidebar-card">
        <h3>Quick Filters</h3>
        <div class="quick-links">
          <%= link_to "All Products", products_path, class: "mini-pill" %>
          <%= link_to "On Sale", products_path(filter: "sale"), class: "mini-pill" %>
          <%= link_to "New Arrivals", products_path(filter: "new"), class: "mini-pill" %>
        </div>
      </div>

      <div class="sidebar-card">
        <h3>Categories</h3>
        <div class="quick-links">
          <% @categories.each do |category| %>
            <%= link_to category.name, products_path(category_id: category.id), class: "mini-pill" %>
          <% end %>
        </div>
      </div>
    </aside>

    <section class="catalog-content">
      <h3 class="section-title">Products</h3>

      <div class="products-grid">
        <% @products.each do |product| %>
          <article class="product-card">
            <h4>
              <%= link_to product.name, product_path(product) %>
            </h4>

            <% if product.image.attached? %>
              <%= image_tag product.image, class: "product-image" %>
            <% end %>

            <p class="product-description"><%= product.description %></p>

            <p><strong>Price:</strong> <%= number_to_currency(product.price) %></p>

            <p>
              <strong>Categories:</strong>
              <%= product.categories.map(&:name).join(", ") %>
            </p>

            <div class="badge-row">
              <% if product.on_sale %>
                <span class="status-badge on-sale-badge">On Sale</span>
              <% end %>

              <% if product.new_arrival %>
                <span class="status-badge new-arrival-badge">New Arrival</span>
              <% end %>
            </div>

            <%= button_to "Add to Cart", add_to_cart_path(product), method: :post, class: "btn-secondary" %>
          </article>
        <% end %>
      </div>

      <div class="pagination-wrap">
        <%= paginate @products if @products.respond_to?(:current_page) %>
      </div>
    </section>
  </div>
</section>