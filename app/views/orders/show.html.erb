<section class="invoice-page">
  <div class="invoice-card">
    <div class="invoice-header">
      <div class="invoice-brand">
        <div class="invoice-logo">PPM</div>
        <div>
          <h1>Prairie Pantry Market</h1>
          <p>Local pantry products, gifts, and everyday favourites.</p>
        </div>
      </div>

      <div class="invoice-title">
        <h2>Invoice</h2>
        <p>Order #<%= @order.id %></p>
      </div>
    </div>

    <div class="invoice-grid">
      <div class="invoice-box">
        <h3>Bill To</h3>
        <% customer = @order.customer %>
        <% customer_name = [customer&.first_name, customer&.last_name].compact.join(" ") %>

        <p><strong><%= customer_name.presence || "Customer" %></strong></p>
        <p><%= customer&.email %></p>
        <p>
          <%= customer&.street %><br>
          <%= customer&.city %>,
          <%= @order.province&.name %>
          <%= customer&.postal_code %>
        </p>
      </div>

      <div class="invoice-box">
        <h3>Order Details</h3>
        <p><strong>Status:</strong> <%= @order.status.to_s.titleize %></p>
        <p><strong>Province:</strong> <%= @order.province&.name || "N/A" %></p>
        <p><strong>Date:</strong> <%= @order.created_at.strftime("%B %d, %Y") %></p>
      </div>
    </div>

    <table class="clean-table invoice-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Quantity</th>
          <th>Unit Price at Purchase</th>
          <th>Line Total</th>
        </tr>
      </thead>

      <tbody>
        <% @order.order_items.each do |item| %>
          <tr>
            <td><%= item.product&.name || "Product unavailable" %></td>
            <td><%= item.quantity %></td>
            <td><%= number_to_currency(item.unit_price_cents.to_i / 100.0) %></td>
            <td><%= number_to_currency(item.line_total_cents.to_i / 100.0) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="invoice-bottom">
      <div class="invoice-note">
        <h3>Thank you for your order</h3>
        <p>
          This invoice confirms the products, quantities, taxes, and final total
          saved at the time of checkout.
        </p>
      </div>

      <div class="invoice-totals">
        <p><span>Subtotal</span> <strong><%= number_to_currency(@order.subtotal_cents.to_i / 100.0) %></strong></p>
        <p><span>GST</span> <strong><%= number_to_currency(@order.gst_cents.to_i / 100.0) %></strong></p>
        <p><span>PST</span> <strong><%= number_to_currency(@order.pst_cents.to_i / 100.0) %></strong></p>
        <p><span>HST</span> <strong><%= number_to_currency(@order.hst_cents.to_i / 100.0) %></strong></p>
        <p class="grand-total"><span>Grand Total</span> <strong><%= number_to_currency(@order.total_cents.to_i / 100.0) %></strong></p>
      </div>
    </div>

    <div class="page-actions">
      <%= link_to "Continue Shopping", products_path, class: "btn-secondary" %>
      <%= link_to "Back to Orders", orders_path, class: "btn-primary" %>
    </div>
  </div>
</section>